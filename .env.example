# GEMINI_API_KEY: Required on the server only for Gemini AI API calls.
# Never prefix with VITE_ and never expose this key to client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional server-side model override (default: gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
