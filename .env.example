# BYOK_ENCRYPTION_SECRET: 32+ char random server secret used ONLY on server routes
# to AES-256-GCM encrypt per-user personal Gemini API keys in /users/{uid}/aiConfig/vault
# and seal HttpOnly cookies across Vercel serverless functions.
# REQUIRED in Vercel Production; optional in single-process local preview.
BYOK_ENCRYPTION_SECRET="CHANGE_TO_A_LONG_RANDOM_SERVER_SECRET"

# GEMINI_MODEL: Optional server-side model override (default: gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# Optional Firebase overrides for serverless functions if firebase-applet-config.json is omitted:
# FIREBASE_PROJECT_ID=""
# FIREBASE_FIRESTORE_DATABASE_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
